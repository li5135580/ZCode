++++ b/.github/workflows/sync-upstream.yml
+@@ -0,0 +1,107 @@
++name: Sync Upstream
++
++on:
++  schedule:
++    - cron: '0 * * * *'  # 每小时检测
++  workflow_dispatch:      # 支持手动触发
++
++permissions:
++  contents: write
++  issues: write
++
++jobs:
++  sync:
++    runs-on: ubuntu-latest
++    steps:
++      - name: Checkout
++        uses: actions/checkout@v4
++        with:
++          fetch-depth: 0
++          token: ${{ secrets.GITHUB_TOKEN }}
++
++      - name: Setup Git
++        run: |
++          git config user.name "github-actions[bot]"
++          git config user.email "github-actions[bot]@users.noreply.github.com"
++
++      - name: Add upstream remote
++        run: |
++          git remote add upstream https://github.com/zai-org/ZCode.git || true
++          git fetch upstream
++
++      - name: Check for updates
++        id: check
++        run: |
++          UPSTREAM_SHA=$(git rev-parse upstream/main)
++          CURRENT_SHA=$(git rev-parse HEAD)
++          echo "upstream_sha=$UPSTREAM_SHA" >> $GITHUB_OUTPUT
++          echo "current_sha=$CURRENT_SHA" >> $GITHUB_OUTPUT
++          if [ "$UPSTREAM_SHA" == "$CURRENT_SHA" ]; then
++            echo "has_updates=false" >> $GITHUB_OUTPUT
++          else
++            echo "has_updates=true" >> $GITHUB_OUTPUT
++          fi
++
++      - name: Sync upstream
++        if: steps.check.outputs.has_updates == 'true'
++        run: |
++          # 备份二开补丁。只备份 patches/0NN-*.patch（二开补丁命名约定，
++          # 见 patches/README.md），避免误用 pnpm patchedDependencies 的依赖补丁
++          #（如 patches/vitest@*.patch、patches/@arms__*.patch）。
++          mkdir -p /tmp/custom-patches
++          if compgen -G "patches/0*.patch" > /dev/null 2>&1; then
++            cp patches/0*.patch /tmp/custom-patches/
++          fi
++
++          # 自动合并上游代码，保留本地历史与补丁文件。冲突时中止并退出，
++          # 由下方 failure() 步骤创建 Issue 通知人工处理。
++          git merge upstream/main --no-edit || {
++            echo "Merge conflict with upstream"
++            git merge --abort
++            exit 1
++          }
++
++          # 恢复并应用二开补丁（merge 快进时补丁文件可能被上游版本覆盖）
++          if compgen -G "/tmp/custom-patches/*.patch" > /dev/null 2>&1; then
++            for patch in /tmp/custom-patches/*.patch; do
++              echo "Applying $patch"
++              git apply "$patch" --3way || {
++                echo "Conflict applying $patch"
++                exit 1
++              }
++              # 补丁文件原样放回 patches/，供下次同步继续复用
++              mkdir -p patches
++              cp "$patch" "patches/$(basename "$patch")"
++            done
++          fi
++
++          # 提交变更并推送（非 force，避免覆盖他人/历史提交）
++          git add .
++          git commit -m "chore: sync upstream $(git rev-parse --short upstream/main)" || true
++          git push origin main
++
++      - name: Create issue on conflict
++        if: failure()
++        uses: actions/github-script@v7
++        with:
++          script: |
++            const owner = context.repo.owner;
++            const repo = context.repo.repo;
++            // 幂等创建 label，避免 labels 引用不存在导致 issues.create 返回 422
++            try {
++              await github.rest.issues.createLabel({
++                owner,
++                repo,
++                name: 'sync-conflict',
++                color: 'd73a4a',
++              });
++            } catch (error) {
++              if (error.status !== 422) throw error;
++            }
++            await github.rest.issues.create({
++              owner,
++              repo,
++              title: '⚠️ Upstream sync conflict detected',
++              body: 'Automatic sync failed due to merge conflicts. Please resolve manually.',
++              labels: ['sync-conflict'],
++            });
